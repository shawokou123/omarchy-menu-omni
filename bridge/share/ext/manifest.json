{
  "manifest_version": 3,
  "name": "Omarchy Web bridge",
  "version": "1.44",
  "description": "Answers launcher questions inside the user's own chat tabs (DeepSeek, ChatGPT). Driven only by a local native messaging host.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "gpt.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://x.com/i/grok*",
        "https://twitter.com/i/grok*",
        "https://grok.com/*"
      ],
      "js": [
        "grok.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
